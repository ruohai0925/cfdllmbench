# Unpacked benchmark cases and their run results.
# Regenerate with: python tools/unpack.py
Dataset/Basic/
Dataset/Advanced/

# Fetched from outside the package. The unmodified Kaggle JSONs are tracked so
# tools/patch_dataset.py can re-derive the v1 data offline; Foam-Agent has its
# own git repo and is cloned by tools/fetch_upstream.sh.
upstream/*
!upstream/FoamBench_basic.json
!upstream/FoamBench_advanced.json

