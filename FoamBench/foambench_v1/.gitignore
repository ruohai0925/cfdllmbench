# Unpacked benchmark cases and their run results.
# Regenerate with: python tools/unpack.py
Dataset/Basic/
Dataset/Advanced/

# Fetched from outside the package. The unmodified Kaggle JSONs are tracked so
# tools/patch_dataset.py can re-derive the v1 data offline; Foam-Agent has its
# own git repo and is cloned by tools/fetch_upstream.sh.
upstream/*
!upstream/FoamBench_basic.json
!upstream/FoamBench_advanced.json

# Working notes: audit trail, model scan reports, pipeline analysis.
# Local only -- CHANGELOG.md is the authoritative record of every change.
docs/

# Scoring output. The GT run summary, the Foam-Agent run summary, the per-case score
# table and the final table are tracked; the intermediate per-metric CSVs are not.
results/*.csv
!results/final_benchmark_scores.csv

__pycache__/
*.pyc

# Per-experiment copies of submissions (moved out of Dataset/ so scoring sees one run per case)
results/runs/
